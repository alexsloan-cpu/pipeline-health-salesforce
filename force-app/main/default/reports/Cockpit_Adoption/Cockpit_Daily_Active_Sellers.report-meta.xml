<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <name>Cockpit daily active sellers, 30 days</name>
    <description>Sellers who opened the cockpit each day, split by AE and BDR. Each row is one seller-day, so the record count is daily active sellers.</description>
    <format>Matrix</format>
    <reportType>Cockpit_Usage_Days__c</reportType>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <columns><aggregateTypes>Sum</aggregateTypes><field>Cockpit_Usage_Day__c$Active_Minutes__c</field></columns>
    <groupingsAcross>
        <dateGranularity>None</dateGranularity>
        <field>Cockpit_Usage_Day__c$Cockpit__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsAcross>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Cockpit_Usage_Day__c$Usage_Date__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <timeFrameFilter>
        <dateColumn>Cockpit_Usage_Day__c$Usage_Date__c</dateColumn>
        <interval>INTERVAL_LAST30</interval>
    </timeFrameFilter>
</Report>
