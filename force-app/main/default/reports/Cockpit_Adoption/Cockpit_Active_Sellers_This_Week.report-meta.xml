    <columns><aggregateTypes>Sum</aggregateTypes><field>Cockpit_Usage_Day__c$Active_Minutes__c</field></columns>
    <columns><aggregateTypes>Sum</aggregateTypes><field>Cockpit_Usage_Day__c$Actions_Completed__c</field></columns>
    <columns><aggregateTypes>Sum</aggregateTypes><field>Cockpit_Usage_Day__c$Updates_Saved__c</field></columns>
