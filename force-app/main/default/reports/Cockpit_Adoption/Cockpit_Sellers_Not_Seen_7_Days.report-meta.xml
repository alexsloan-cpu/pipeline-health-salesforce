<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <name>Sellers with no cockpit use in 7 days</name>
    <description>Active AEs with no Cockpit Usage Day in the last 7 days. Add the pilot group to the role filter during the pilot.</description>
    <format>Tabular</format>
    <reportType>User</reportType>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>false</showSubTotals>
    <columns><field>FULL_NAME</field></columns>
    <columns><field>ROLE</field></columns>
    <crossFilters>
        <criteriaItems>
            <column>Usage_Date__c</column>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>LAST_N_DAYS:7</value>
        </criteriaItems>
        <operation>without</operation>
        <primaryTableColumn>USER_ID</primaryTableColumn>
        <relatedTable>Cockpit_Usage_Day__c</relatedTable>
        <relatedTableJoinColumn>User__c</relatedTableJoinColumn>
    </crossFilters>
    <filter>
        <criteriaItems>
            <column>ACTIVE</column>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>1</value>
        </criteriaItems>
        <criteriaItems>
            <column>ROLE</column>
            <isUnlocked>true</isUnlocked>
            <operator>startsWith</operator>
            <value>AE -</value>
        </criteriaItems>
    </filter>
    <timeFrameFilter>
        <dateColumn>CREATED_DATE</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
