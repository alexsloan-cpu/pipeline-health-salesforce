<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Deal Milestones by Stage</masterLabel>
    <description>Milestones grouped by Stage 0 to 5 for every record type, as an expandable list or a stage board. Read only.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Deal_Milestones__c</object>
            </objects>
            <property name="layout" type="String" label="Layout" datasource="newBusiness,organicGrowth,newProduct,renewal,auto" default="newBusiness" description="Which milestone set to show."/>
            <property name="variant" type="String" label="Variant" datasource="list,board" default="list" description="List groups by stage with reasons. Board shows one lane per stage."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>