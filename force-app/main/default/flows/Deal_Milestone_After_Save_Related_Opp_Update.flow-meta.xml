        <label>Notify Fault</label>
        <locationX>800</locationX>
        <locationY>540</locationY>
        <flowName>PH_Notify_Fault</flowName>
        <inputAssignments>
            <name>inFlowName</name>
            <value>
                <stringValue>Deal_Milestone_After_Save_Related_Opp_Update</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inRecordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inErrorMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
