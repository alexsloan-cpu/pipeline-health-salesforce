<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>New_Milestone_Back_Link</name>
        <label>New milestone, back-link</label>
        <locationX>158</locationX>
        <locationY>369</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>New_Milestone_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_Back_Link</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Overall_Health_Changed</name>
        <label>Overall Health changed</label>
        <locationX>358</locationX>
        <locationY>200</locationY>
        <defaultConnector>
            <targetReference>New_Milestone_Back_Link</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Health_Changed_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Overall_Health__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Overall_Health__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_Close_Health_field</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>V7 draft 2026-10-26: trigger changed from Update to Create and Update; entry criteria (Overall_Health__c IsChanged) removed. Added decision Overall_Health_Changed (prior exists AND Overall_Health__c differs from prior AND Opportunity__c not null) routing to the existing Update_Opportunity_Close_Health_field. Added decision New_Milestone_Back_Link (no prior AND Opportunity__c not null) routing to new Update_Opportunity_Back_Link (Opportunity where Id = Opportunity__c and Deal_Milestones__c is null, sets Deal_Milestones__c = this record), replacing Manual_Milestones_v3 which matched on Opportunity_Id_15_digit__c text. Added Notify_Fault subflow (PH_Notify_Fault) with fault connectors on both updates. Label renamed to PH Milestone After Save. Prior description: Updates Opportunity.Deal_Review_Short_Version__c when Overall_Health__c changes on the Pipeline Health record. v43: no longer fires on Update_Fields__c changes. That path saved the Opportunity, which tripped Milestones_Update_Checkbox_with_stage_change and set both trigger boxes back to true.</description>
    <environments>Default</environments>
    <interviewLabel>Deal Milestone - After Save - Related Opp Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PH Milestone After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Opportunity_Back_Link</name>
        <label>Back-link Opportunity to new milestone</label>
        <locationX>158</locationX>
        <locationY>540</locationY>
        <faultConnector>
            <targetReference>Notify_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Deal_Milestones__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Deal_Milestones__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <description>Updates Opportunity Close HEalth field on the actual Opp record.</description>
        <name>Update_Opportunity_Close_Health_field</name>
        <label>Update Opportunity Close Health field</label>
        <locationX>485</locationX>
        <locationY>369</locationY>
        <faultConnector>
            <targetReference>Notify_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Deal_Review_Short_Version__c</field>
            <value>
                <elementReference>$Record.Overall_Health__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Opportunity__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>358</locationX>
        <locationY>47</locationY>
        <connector>
            <targetReference>Overall_Health_Changed</targetReference>
        </connector>
        <object>Deal_Milestones__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
