<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>V14 draft 2026-10-26: logic unchanged (after-save on Update when Update_Fields__c or Automation_Trigger__c becomes true; 3 minute scheduled path clears Automation_Trigger__c and Update_Fields__c and stamps Last_Update_Triggered__c). Added Notify_Fault subflow (PH_Notify_Fault) with a fault connector on Set_Checkbox_to_FALSE. This flow is now the sole resetter of the trigger checkboxes; Milestone_Automation_Trigger_set_to_FALSE_after_5_minutes is to be retired.</description>
    <environments>Default</environments>
    <interviewLabel>Deal Milestone - Update Checkbox to FALSE {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Deal Milestone - Update Checkbox to FALSE</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Checkbox_to_FALSE</name>
        <label>Set Checkbox to FALSE</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Notify_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Automation_Trigger__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Last_Update_Triggered__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Update_Fields__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Update_Fields__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Automation_Trigger__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Deal_Milestones__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <name>Wait_3_minutes</name>
            <connector>
                <targetReference>Set_Checkbox_to_FALSE</targetReference>
            </connector>
            <label>Wait 3 minutes</label>
            <offsetNumber>3</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Notify_Fault</name>
        <label>Notify Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>PH_Notify_Fault</flowName>
        <inputAssignments>
            <name>inFlowName</name>
            <value>
                <stringValue>Deal_Milestone_Update_Checkbox_to_FALSE</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inRecordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inErrorMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
